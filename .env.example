# Copie este arquivo para .env e preencha suas chaves de API
# cp .env.example .env

# Chave da AssemblyAI — obtenha em https://www.assemblyai.com/app
ASSEMBLYAI_API_KEY=sua_chave_aqui

# Chave da Deepgram — obtenha em https://console.deepgram.com
DEEPGRAM_API_KEY=sua_chave_aqui

# (Opcional) Pasta monitorada para auto-transcrição
# WATCH_DIRECTORY=C:\Users\SeuUsuario\Documentos\Gravacoes
